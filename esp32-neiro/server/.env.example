# =============================================================================
# ESP32 neiro — настройки LLM
# Скопируйте в .env и заполните значения. НЕ коммитьте .env в git!
# =============================================================================

# Провайдер: auto (рекомендуется) | google | ollama | openai | anthropic
# auto = Gemini первым, при исчерпании квоты → Ollama на homeserv
LLM_PROVIDER=auto

# --- Google Gemini (облако) ---
GOOGLE_API_KEY=ваш-ключ-gemini
GOOGLE_MODEL=gemini-2.0-flash
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# --- Ollama на homeserv (локальная сеть 192.168.1.x) ---
# OpenAI-совместимый API, ключ не проверяется
OLLAMA_BASE_URL=http://192.168.1.112:11434/v1
OLLAMA_API_KEY=ollama
# Модели: qwen2.5-coder:7b (быстро) | qwen2.5-coder:14b (сложные задачи) | qwen2.5-coder:3b
OLLAMA_MODEL=qwen2.5-coder:7b

# --- OpenAI (опционально) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (опционально) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# --- Сервер FastAPI (Kali / homeserv) ---
HOST=0.0.0.0
PORT=8000

# Токен доступа (ESP32 + дашборд). Одинаковый в прошивке и .env на сервере.
# Оставьте пустым только для локальной отладки без защиты.
ESP32_API_TOKEN=esp32-neiro-change-me
