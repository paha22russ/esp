# Провайдер LLM: openai | anthropic | google
LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Anthropic (опционально)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Google Gemini (опционально)
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# Настройки сервера
HOST=0.0.0.0
PORT=8000
